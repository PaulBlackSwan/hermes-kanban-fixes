+"""Synthetic receipts only: no Desktop client, inference or external delivery."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from tui_gateway import server
+
+
+@pytest.mark.parametrize("kind", ["blocked", "block_loop_detected", "review_requested", "changes_requested"])
+def test_attention_event_is_claimed_once_for_exact_session(kind):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="Synthetic attention", assignee="worker", created_by="coordinator")
+        kbn.add_notify_sub(conn, task_id=tid, platform="tui", chat_id="synthetic-owner",
+                           notifier_profile="coordinator")
+        kb._append_event(conn, tid, kind, {"reason": "Read full evidence before deciding", "summary": "Ready for review"})
+        assert server._collect_kanban_notifications({"session_key": "foreign"}) == []
+        texts = server._collect_kanban_notifications({"session_key": "synthetic-owner"})
+        assert len(texts) == 1
+        assert tid in texts[0]
+        if kind in {"blocked", "block_loop_detected"}:
+            assert "BLOCK_FOLLOWUP_V1" in texts[0]
+            assert "@coordinator" in texts[0]
+            assert "dated review" in texts[0]
+            assert "No automatic unblock" in texts[0]
+        assert server._collect_kanban_notifications({"session_key": "synthetic-owner"}) == []
+
+
+@pytest.mark.parametrize("kind", ["blocked", "block_loop_detected"])
+def test_block_reason_retains_action_after_legacy_clip(kind):
+    reason = "Context " * 24 + "ACTION REQUIRED"
+    text = server._format_kanban_event_text(
+        {"task_id": "synthetic"}, SimpleNamespace(title="Synthetic", assignee="worker", created_by="coordinator"),
+        SimpleNamespace(kind=kind, payload={"reason": reason}), "")
+    assert text is not None and "ACTION REQUIRED" in text
+    assert "inspect this card" in text
