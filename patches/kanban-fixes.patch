+++ b/tests/hermes_cli/test_kanban_block_followup.py
@@ -0,0 +1,314 @@
+"""Blocked-card controls use native comments, cursor delivery and bounded loops."""
+from datetime import UTC, datetime
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from hermes_cli import loops
+from tui_gateway import server
+
+spec = importlib.util.spec_from_file_location(
+    "block_control", Path(__file__).resolve().parents[2] / "scripts/kanban_block_followup.py"
+)
+control = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(control)
+NOW = datetime(2026, 10, 24, 10, tzinfo=UTC)
+
+
+@pytest.fixture
+def incident():
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="external prerequisite", assignee="worker", created_by="coordinator")
+        kbn.add_notify_sub(conn, task_id=tid, platform="tui", chat_id="coordinator-session",
+                           notifier_profile="coordinator")
+        kb.claim_task(conn, tid)
+        assert kb.block_task(conn, tid, reason="Maintainer must approve workflows", kind="capability")
+        event = [ev for ev in kb.list_events(conn, tid) if ev.kind == "blocked"][-1]
+        yield conn, tid, event.id
+
+
+def record(conn, tid, event_id, **changes):
+    data = {"version": 1, "event_id": event_id, "owner": "coordinator",
+            "next_action": "Ask the owner to approve the prepared maintainer request",
+            "condition": "Workflows approved on exact head", "review_at": "2026-10-25T10:00:00Z",
+            "state": "waiting"}
+    data.update(changes)
+    kb.add_comment(conn, tid, "coordinator", control.PREFIX + json.dumps(data))
+    return data
+
+
+def scan():
+    return control.report(kb.kanban_db_path(), coordinator="coordinator",
+                          session_id="coordinator-session", now=NOW)
+
+
+def test_missing_followup_is_actionable_not_automatic_retry(incident):
+    conn, tid, eid = incident
+    state = kb.get_task(conn, tid)
+    result = scan()
+    assert result["scoped_count"] == result["due_count"] == 1
+    card = result["cards"][0]
+    assert card["event_id"] == eid and card["owner"] == "coordinator"
+    assert "No automatic retry" in card["next_action"]
+    assert not card["receipt_verified_by_this_control"]
+    assert kb.get_task(conn, tid) == state
+
+
+def test_acknowledged_future_wait_and_due_review(incident):
+    conn, tid, eid = incident
+    data = record(conn, tid, eid)
+    assert scan()["due_count"] == 0
+    result = control.report(kb.kanban_db_path(), coordinator="coordinator",
+                            session_id="coordinator-session", now=control.instant(data["review_at"]))
+    assert result["due_count"] == 1
+    assert result["cards"][0]["next_action"] == data["next_action"]
+    assert result["cards"][0]["control_kind"] == "review_due"
+
+
+def test_resolved_triage_gets_admin_action_without_unblock(incident):
+    conn, tid, _ = incident
+    assert kb.unblock_task(conn, tid)
+    assert kb.claim_task(conn, tid)
+    assert kb.block_task(conn, tid, kind="capability", reason="unchanged external prerequisite")
+    eid = kb.list_events(conn, tid)[-1].id
+    record(conn, tid, eid, state="resolved", review_at="2026-10-24T09:00:00Z",
+           next_action="Apply approved administrative completion, do not redeploy")
+    card = scan()["cards"][0]
+    assert card["control_kind"] == "administrative_close"
+    assert card["due"]
+    assert kb.get_task(conn, tid).status == "triage"
+    assert kb.get_task(conn, tid).block_recurrences == kb.BLOCK_RECURRENCE_LIMIT
+
+
+def test_old_incident_or_untrusted_author_cannot_silence_block(incident):
+    conn, tid, eid = incident
+    data = record(conn, tid, eid - 1)
+    kb.add_comment(conn, tid, "foreign-profile", control.PREFIX + json.dumps({**data, "event_id": eid}))
+    assert scan()["cards"][0]["control_kind"] == "missing_followup"
+
+
+@pytest.mark.parametrize("changes", [{"review_at": "2026-10-25T10:00:00"}, {"owner": ""},
+                                      {"next_action": ""}, {"state": "closed"}])
+def test_malformed_trace_is_reported_not_silent(incident, changes):
+    conn, tid, eid = incident
+    record(conn, tid, eid, **changes)
+    card = scan()["cards"][0]
+    assert card["due"] and card["trace_error"]
+
+
+@pytest.mark.parametrize("review_at", [None, 123, [], {}, "0001-01-01T00:00:00+01:00",
+                                      "9999-12-31T23:59:59-01:00"],
+                         ids=["null", "integer", "list", "object", "utc-underflow", "utc-overflow"])
+def test_invalid_date_preserves_other_cards_and_cli_readonly_report(incident, review_at):
+    conn, tid, eid = incident
+    record(conn, tid, eid, review_at=review_at)
+    healthy = kb.create_task(conn, title="Separate prerequisite", assignee="worker",
+                             created_by="coordinator")
+    assert kb.claim_task(conn, healthy)
+    assert kb.block_task(conn, healthy, reason="Separate approval pending", kind="capability")
+    healthy_eid = [ev.id for ev in kb.list_events(conn, healthy) if ev.kind == "blocked"][-1]
+    data = record(conn, healthy, healthy_eid, review_at="2099-10-25T10:00:00Z")
+    before = tuple(conn.iterdump())
+
+    result = scan()
+    process = subprocess.run(
+        [sys.executable, str(Path(__file__).resolve().parents[2] / "scripts/kanban_block_followup.py"), "--db", str(kb.kanban_db_path()),
+         "--coordinator", "coordinator", "--session-id", "coordinator-session"],
+        capture_output=True, text=True, timeout=30, check=False,
+    )
+    assert process.returncode == 0, process.stderr
+    assert process.stderr == ""
+    for report in (result, json.loads(process.stdout)):
+        assert report["read_only"] and not report["automatic_timer_created"]
+        assert report["scoped_count"] == 2 and report["due_count"] == 1
+        cards = {card["task_id"]: card for card in report["cards"]}
+        invalid, valid = cards[tid], cards[healthy]
+        assert invalid["due"] and invalid["control_kind"] == "missing_followup"
+        assert invalid["state"] == "unmanaged" and invalid["review_at"] is None
+        expected_error = ("review_at is outside the supported UTC range" if isinstance(review_at, str)
+                          else "review_at must be a non-empty ISO 8601 string")
+        assert expected_error in invalid["trace_error"]
+        assert invalid["trace_comment_id"] is not None
+        assert not valid["due"] and valid["control_kind"] == "waiting"
+        assert valid["trace_error"] is None and valid["review_at"] == data["review_at"]
+        assert valid["next_action"] == data["next_action"]
+    assert tuple(conn.iterdump()) == before
+
+
+def test_other_coordinator_and_terminal_tasks_excluded(incident):
+    conn, tid, _ = incident
+    other = kb.create_task(conn, title="private subject", assignee="foreign-profile", created_by="other-owner")
+    kb.claim_task(conn, other)
+    assert kb.block_task(conn, other, reason="private prerequisite", kind="capability")
+    result = scan()
+    assert [x["task_id"] for x in result["cards"]] == [tid]
+    assert "private prerequisite" not in json.dumps(result)
+    assert kb.complete_task(conn, tid, summary="Verified completion")
+    assert scan()["scoped_count"] == 0
+
+
+def test_readonly_scan_does_not_write_or_create_missing_db(incident, tmp_path):
+    conn, _, _ = incident
+    before = list(conn.execute("SELECT * FROM task_events"))
+    for _ in range(3):
+        scan()
+    assert list(conn.execute("SELECT * FROM task_events")) == before
+    missing = tmp_path / "missing.db"
+    with pytest.raises(Exception):
+        control.report(missing, coordinator="coordinator", session_id="coordinator-session", now=NOW)
+    assert not missing.exists()
+
+
+def test_native_new_block_receipt_only_exact_session_and_once(incident, monkeypatch):
+    conn, tid, _ = incident
+    state = kb.get_task(conn, tid)
+    receipts = []
+    emitted = []
+    session = {"session_key": "coordinator-session", "running": True,
+               "history_lock": threading.RLock()}
+    monkeypatch.setattr(server, "_emit", lambda *args: emitted.append(args))
+    def submit(rid, sid, sess, text, **kwargs):
+        receipts.append((sid, text))
+        sess["running"] = False
+        return True
+    monkeypatch.setattr(server, "_run_prompt_submit", submit)
+    assert server._collect_kanban_notifications({"session_key": "foreign"}) == []
+    server._notif_poll_kanban("coordinator-ui", session)
+    assert not receipts and session["_kanban_pending"]
+    session["running"] = False
+    server._notif_poll_kanban("coordinator-ui", session)
+    server._notif_poll_kanban("coordinator-ui", session)
+    assert len(receipts) == 1
+    assert receipts[0][0] == "coordinator-ui" and tid in receipts[0][1]
+    assert "@coordinator" in receipts[0][1]
+    assert "next action" in receipts[0][1] and "dated review" in receipts[0][1]
+    assert "Maintainer must approve workflows" in receipts[0][1]
+    assert any(e[0] == "status.update" for e in emitted)
+    assert kb.get_task(conn, tid) == state
+
+
+def test_native_three_controls_baseline_plus_two_reminders_then_stop(incident, monkeypatch):
+    conn, tid, eid = incident
+    record(conn, tid, eid, review_at="2026-10-25T10:00:00Z")
+    clock = [NOW.timestamp()]
+    monkeypatch.setattr(loops.time, "time", lambda: clock[0])
+    parsed = loops.parse_loop_args("24h Inspect blocked-card follow-up --times 3")
+    assert not parsed["error"]
+    sid = "bounded-control-session"
+    manager = loops.LoopManager(sid)
+    manager.set(parsed["prompt"], interval_seconds=parsed["interval_seconds"], times=parsed["times"])
+    assert manager.is_due()  # Native /loop first control is immediate, not tomorrow.
+    receipts = []
+    for tick in range(3):
+        active = loops.LoopManager(sid)  # Reload durable state every time.
+        assert active.is_due()
+        assert active.fire_tick()
+        assert not loops.LoopManager(sid).is_due()
+        result = control.report(kb.kanban_db_path(), coordinator="coordinator",
+                                session_id="coordinator-session", now=datetime.fromtimestamp(clock[0], UTC))
+        receipts.append(result["due_count"])
+        decision = active.complete_tick("Control completed; awaiting external prerequisite")
+        if tick < 2:
+            assert not decision["stopped"] and not active.is_due()
+        clock[0] += 86400
+    assert receipts == [0, 1, 1]
+    assert decision["stopped"] and loops.LoopManager(sid).state.status == "done"
+    assert not loops.LoopManager(sid).is_due()
+    assert kb.get_task(conn, tid).status == "blocked"
+
+
+def test_native_loop_early_stop_marker(incident):
+    manager = loops.LoopManager("resolved-control-session")
+    manager.set("Inspect follow-up", interval_seconds=86400, times=3)
+    assert manager.fire_tick()
+    assert manager.complete_tick("Nothing left to follow\nLOOP_COMPLETE")["stopped"]
+    assert not loops.LoopManager("resolved-control-session").is_due()
+
+
+def test_approved_triage_completes_directly_without_dispatchable_intermediate(incident):
+    conn, tid, _ = incident
+    kb.unblock_task(conn, tid)
+    kb.claim_task(conn, tid)
+    kb.block_task(conn, tid, kind="capability", reason="Second block")
+    assert kb.get_task(conn, tid).status == "triage"
+    before = kb.list_events(conn, tid)[-1].id
+    with pytest.raises(kb.EmptyCompletionError):
+        kb.complete_task(conn, tid, summary=" ")
+    assert kb.get_task(conn, tid).status == "triage"
+    assert not kb.complete_task(conn, tid, summary="verified", expected_run_id=999999)
+    assert kb.complete_task(conn, tid, summary="Verified deployment and independent approval",
+                            metadata={"review_task": "independent-review", "approval": "confirmed"})
+    assert kb.get_task(conn, tid).status == "done"
+    events = [e.kind for e in kb.list_events(conn, tid) if e.id > before]
+    assert "completed" in events
+    assert "unblocked" not in events and "claimed" not in events
+    assert scan()["scoped_count"] == 0
+
+
+def test_pr_gate_still_prevents_triage_completion(incident, monkeypatch):
+    from hermes_cli import kanban_pr_acceptance_store
+    conn, tid, _ = incident
+    kb.unblock_task(conn, tid)
+    kb.claim_task(conn, tid)
+    kb.block_task(conn, tid, kind="capability", reason="CI approval pending")
+    calls = []
+    def refuse(*args):
+        calls.append(args)
+        return False
+    monkeypatch.setattr(kanban_pr_acceptance_store, "prepare_acceptance", refuse)
+    assert not kb.complete_task(conn, tid, summary="Locally tested but no required CI receipt")
+    assert calls and kb.get_task(conn, tid).status == "triage"
+
+
+def test_subscribed_adopted_card_is_included_but_foreign_session_is_not(incident):
+    conn, tid, _ = incident
+    adopted = kb.create_task(conn, title="Adopted work", assignee="worker", created_by="another-creator")
+    kb.claim_task(conn, adopted)
+    kb.block_task(conn, adopted, reason="External approval", kind="capability")
+    kbn.add_notify_sub(conn, task_id=adopted, platform="tui", chat_id="other-session",
+                       notifier_profile="coordinator")
+    assert scan()["scoped_count"] == 1
+    kbn.add_notify_sub(conn, task_id=adopted, platform="tui", chat_id="coordinator-session",
+                       notifier_profile="coordinator")
+    assert {card["task_id"] for card in scan()["cards"]} == {tid, adopted}
+
+
+def test_native_idle_driver_delivers_control_receipts_and_exhausts_budget(incident, monkeypatch):
+    conn, tid, eid = incident
+    record(conn, tid, eid, review_at="2026-10-25T10:00:00Z")
+    clock = [NOW.timestamp()]
+    monkeypatch.setattr(loops.time, "time", lambda: clock[0])
+    sid = "control-driver-session"
+    manager = loops.LoopManager(sid)
+    manager.set("Inspect follow-up using read-only controller", interval_seconds=86400, times=3)
+    sess = {"session_key": sid, "history_lock": threading.RLock(), "running": True}
+    receipts = []
+    monkeypatch.setattr(server, "_emit", lambda *args: None)
+    def submit(rid, ui_sid, session, text, **kwargs):
+        assert ui_sid == "control-ui" and "Inspect follow-up" in text
+        result = control.report(kb.kanban_db_path(), coordinator="coordinator",
+                                session_id="coordinator-session", now=datetime.fromtimestamp(clock[0], UTC))
+        receipts.append(result["due_count"])
+        loops.LoopManager(sid).complete_tick("Current prerequisite checked; no auto-unblock")
+        session["running"] = False
+        return True
+    monkeypatch.setattr(server, "_run_prompt_submit", submit)
+    server._maybe_fire_tui_loop_tick("control-ui", sess)
+    assert not receipts  # busy session defers, not loses, the due control.
+    sess["running"] = False
+    for _ in range(3):
+        server._maybe_fire_tui_loop_tick("control-ui", sess)
+        server._maybe_fire_tui_loop_tick("control-ui", sess)
+        clock[0] += 86400
+    server._maybe_fire_tui_loop_tick("control-ui", sess)
+    assert receipts == [0, 1, 1]
+    assert loops.LoopManager(sid).state.status == "done"
+    assert kb.get_task(conn, tid).status == "blocked"
