+"""Synthetic gateway wake construction, without admission or network sends."""
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.kanban_watchers_notifier import _KanbanNotification
+
+
+@pytest.mark.parametrize("kind", ["blocked", "block_loop_detected"])
+def test_gateway_block_wake_requires_full_card_and_dated_next_action(kind):
+    task = SimpleNamespace(title="Synthetic", assignee="worker", created_by="coordinator")
+    notice = _KanbanNotification(None, {"sub": {
+        "task_id": "synthetic", "platform": "local", "chat_id": "exact-session",
+        "notifier_profile": "coordinator", "delivery_mode": "wake"},
+        "task": task, "board": "default", "events": [SimpleNamespace(kind=kind, payload={})]},
+        platform_cls=None, sub_fail_counts={})
+    notice.is_push_adapter = False
+    notice.build_wake_text()
+    assert notice.session_key == "exact-session"
+    assert "BLOCK_FOLLOWUP_V1" in notice.synth
+    assert "kanban_show" in notice.synth
+    assert "next action" in notice.synth and "dated review" in notice.synth
+    assert "No automatic unblock" in notice.synth
+
+
+def test_completion_wake_does_not_request_a_block_trace():
+    notice = _KanbanNotification(None, {"sub": {
+        "task_id": "synthetic", "platform": "local", "chat_id": "exact-session", "delivery_mode": "wake"},
+        "task": SimpleNamespace(title="Synthetic", assignee="worker"), "board": "default",
+        "events": [SimpleNamespace(kind="completed", payload={})]}, platform_cls=None, sub_fail_counts={})
+    notice.is_push_adapter = False
+    notice.build_wake_text()
+    assert "BLOCK_FOLLOWUP_V1" not in notice.synth
diff --git a/tests/hermes_cli/test_kanban_block_followup.py b/tests/hermes_cli/test_kanban_block_followup.py
new file mode 100644
